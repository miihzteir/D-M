rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // só vocês dois conseguem ler e escrever
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['EMAIL_DA_MILENA@gmail.com', 'EMAIL_DO_DIOGO@gmail.com'];
    }
  }
}
